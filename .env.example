# Copy to .env and fill in. Never commit the real .env.
# Wrangler ignores .env entirely if a .dev.vars file exists, so do not create one.

# Resend API key used to deliver the article email.
RESEND_KEY=

# Verified Resend sender. Must match the address shown in the app's first-time setup tip.
FROM_EMAIL=web2kindle@confidence.sh
